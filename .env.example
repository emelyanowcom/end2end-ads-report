# Copy to .env and fill in your values

# Monday CRM — lead qualification
MONDAY_API_KEY=your_monday_api_key_here
# Monday board ID for the leads board
# MONDAY_BOARD_ID=1234567890  (optional override, default is hardcoded per project)

# Outline — keyword history storage + report publishing
OUTLINE_API_TOKEN=ol_api_your_token_here
OUTLINE_BASE_URL=https://your-outline-instance.com
OUTLINE_DOC_ID=your-history-doc-uuid          # Google Ads Keyword History document
OUTLINE_COLLECTION_ID=your-collection-uuid    # Collection for reports
OUTLINE_PARENT_DOC_ID=your-parent-doc-uuid    # Parent "Google Ads reports" document

# Google Analytics 4 (optional — keyword-level data requires auto-tagging in Google Ads)
GA4_PROPERTY_ID=123456789
GA4_KEY_FILE=path/to/service-account.json

# Google Ads API (future — not yet implemented)
# GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
# GOOGLE_ADS_CUSTOMER_ID=1234567890
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890  # MCC account if applicable
